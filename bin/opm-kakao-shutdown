#!/usr/bin/env bash

if ! command -v opm-version &> /dev/null; then
PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" || exit; pwd):$PATH"
fi

CONTAINER="${KAKAO_NAME:-kakaotalk}"
# KakaoTalk flushes its local database and drops the session on the way out, and
# wineserver only exits once the last process has. Ten seconds -- what docker
# stops with by default -- can land in the middle of that and leave the prefix
# half-written, so give it a wider margin before the SIGKILL.
TIMEOUT="${KAKAO_STOP_TIMEOUT:-30}"

if ! command -v docker &> /dev/null; then
    opm-println-error "Not found docker command"
    exit 1
fi

# The container runs with --rm, so a missing name means it is already gone.
if ! docker container inspect "$CONTAINER" &> /dev/null; then
    opm-println-info "KakaoTalk is not running"
    exit 0
fi

opm-println-info "Stopping KakaoTalk (up to ${TIMEOUT}s) ..."

# SIGTERM reaches the entrypoint shell, whose trap runs "wineserver -k" to close
# the wine session down cleanly instead of having the container yank it away.
if ! docker stop --time "$TIMEOUT" "$CONTAINER" > /dev/null; then
    opm-println-error "Failed to stop the $CONTAINER container"
    exit 1
fi

opm-println-info "KakaoTalk stopped"
