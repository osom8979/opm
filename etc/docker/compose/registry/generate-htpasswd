#!/usr/bin/env bash
#
# Writes ./htpasswd, which config/config.yml mounts as the registry's basic
# auth database. Distribution only understands bcrypt -- an entry hashed any
# other way is silently ignored and shows up as a wrong password.
#
#   ./generate-htpasswd <username> [password]
#
# With no password one is generated and printed. Running it again for a new
# username appends; for an existing username it replaces that entry.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
HTPASSWD_FILE="$ROOT_DIR/htpasswd"
HTPASSWD_IMAGE="httpd:2-alpine"

red()    { printf "\033[1;31m%s\033[0m\n" "$*"; }
green()  { printf "\033[1;32m%s\033[0m\n" "$*"; }
yellow() { printf "\033[1;33m%s\033[0m\n" "$*"; }

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    red "Usage: $0 <username> [password]"
    exit 1
fi

USERNAME="$1"
PASSWORD="${2:-}"
GENERATED=0

if [ -z "$PASSWORD" ]; then
    PASSWORD="$(openssl rand -base64 24)"
    GENERATED=1
fi

case "$USERNAME" in
    *:*)
        red "Username must not contain ':'"
        exit 1
        ;;
esac

# -B bcrypt, -b password on the command line, -n write to stdout.
ENTRY="$(docker run --rm --entrypoint htpasswd "$HTPASSWD_IMAGE" \
    -Bbn "$USERNAME" "$PASSWORD")"

if [ -z "$ENTRY" ]; then
    red "htpasswd produced nothing -- is docker usable and $HTPASSWD_IMAGE pullable?"
    exit 1
fi

if [ -f "$HTPASSWD_FILE" ] && grep -q "^${USERNAME}:" "$HTPASSWD_FILE"; then
    yellow "Replacing existing entry for '$USERNAME'."
    grep -v "^${USERNAME}:" "$HTPASSWD_FILE" > "${HTPASSWD_FILE}.tmp" || true
    mv "${HTPASSWD_FILE}.tmp" "$HTPASSWD_FILE"
fi

printf '%s\n' "$ENTRY" >> "$HTPASSWD_FILE"
# The registry runs as a non-root user and only needs to read it.
chmod 644 "$HTPASSWD_FILE"

green "Updated: $HTPASSWD_FILE"
if [ "$GENERATED" -eq 1 ]; then
    echo
    yellow "Generated password for '$USERNAME' -- it is not stored anywhere else:"
    printf '  %s\n' "$PASSWORD"
fi
echo
green "Restart the registry to pick it up:  docker compose restart registry"
green "Then:  docker login $(hostname -f 2>/dev/null || hostname) -u $USERNAME"
