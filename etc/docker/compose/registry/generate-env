#!/usr/bin/env bash

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$ROOT_DIR/.env"
TEMPLATE_FILE="$ROOT_DIR/env-template"

red()    { printf "\033[1;31m%s\033[0m\n" "$*"; }
green()  { printf "\033[1;32m%s\033[0m\n" "$*"; }
yellow() { printf "\033[1;33m%s\033[0m\n" "$*"; }

if [ -f "$ENV_FILE" ]; then
    red ".env already exists: $ENV_FILE"
    red "Remove it first if you want to regenerate."
    exit 1
fi

if [ ! -f "$TEMPLATE_FILE" ]; then
    red "Template not found: $TEMPLATE_FILE"
    exit 1
fi

USER_UID="$(id -u)"
USER_GID="$(id -g)"
REGISTRY_HTTP_SECRET="$(openssl rand -hex 32)"
REGISTRY_DOMAIN="$(hostname -f 2>/dev/null || hostname)"

# These cannot be guessed: they belong to the remote S3 site.
S3_HOSTNAME="CHANGE-ME.example.com"
AWS_ACCESS_KEY_ID="CHANGE-ME"
AWS_SECRET_ACCESS_KEY="CHANGE-ME"

sed \
    -e "s/@USER_UID@/$USER_UID/g" \
    -e "s/@USER_GID@/$USER_GID/g" \
    -e "s/@REGISTRY_HTTP_SECRET@/$REGISTRY_HTTP_SECRET/g" \
    -e "s/@REGISTRY_DOMAIN@/$REGISTRY_DOMAIN/g" \
    -e "s/@S3_HOSTNAME@/$S3_HOSTNAME/g" \
    -e "s/@AWS_ACCESS_KEY_ID@/$AWS_ACCESS_KEY_ID/g" \
    -e "s/@AWS_SECRET_ACCESS_KEY@/$AWS_SECRET_ACCESS_KEY/g" \
    "$TEMPLATE_FILE" > "$ENV_FILE"

if [[ $? -ne 0 ]]; then
    red "Failed to generate .env"
    exit 1
fi

green "Generated: $ENV_FILE"
echo
yellow "Edit these before starting -- they are placeholders:"
yellow "  S3_ENDPOINT_URL        tunnel hostname of the remote S3"
yellow "  AWS_ACCESS_KEY_ID      credentials of that S3"
yellow "  AWS_SECRET_ACCESS_KEY"
echo
yellow "And confirm this guess:"
yellow "  REGISTRY_DOMAIN=$REGISTRY_DOMAIN"
