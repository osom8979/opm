#!/usr/bin/env bash
#
# aws-cli pointed at this stack, with the credentials and port from .env.
# The current directory is mounted at /work (the container's workdir), so
# local paths in `aws s3 cp` work as long as they are inside it.
#
#   ./s3 s3 ls
#   ./s3 s3 mb s3://backups
#   ./s3 s3 cp ./report.pdf s3://backups/
#   ./s3 s3api head-bucket --bucket backups

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT_DIR/.env"
AWS_CLI_IMAGE="amazon/aws-cli:2.33.25"

red() { printf "\033[1;31m%s\033[0m\n" "$*" 1>&2; }

if ! command -v docker &> /dev/null; then
    red "Not found docker command"
    exit 1
fi

if [ ! -f "$ENV_FILE" ]; then
    red "Not found .env: $ENV_FILE"
    red "Run ./generate-env first."
    exit 1
fi

if [ $# -eq 0 ]; then
    red "Usage: $0 <aws-cli arguments...>"
    exit 1
fi

# Read only the keys we need instead of sourcing the file: compose accepts
# unquoted values containing spaces (S3_BUCKETS) that bash would try to run.
env_get() {
    sed -n -E "s/^[[:space:]]*$1=//p" "$ENV_FILE" \
        | tail -n 1 \
        | sed -E "s/^\"(.*)\"$/\\1/; s/^'(.*)'$/\\1/"
}

HOST=127.0.0.1
PORT="$(env_get RUSTFS_S3_PORT)"
REGION="$(env_get RUSTFS_REGION)"
ACCESS_KEY="$(env_get RUSTFS_ACCESS_KEY)"
SECRET_KEY="$(env_get RUSTFS_SECRET_KEY)"

if [ -z "$ACCESS_KEY" ] || [ -z "$SECRET_KEY" ]; then
    red "RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY are not set in $ENV_FILE"
    exit 1
fi

docker run --rm -i \
    --network host \
    -u "$(id -u):$(id -g)" \
    -e AWS_ACCESS_KEY_ID="$ACCESS_KEY" \
    -e AWS_SECRET_ACCESS_KEY="$SECRET_KEY" \
    -e AWS_DEFAULT_REGION="${REGION:-us-east-1}" \
    -e AWS_S3_ADDRESSING_STYLE=path \
    -e AWS_REQUEST_CHECKSUM_CALCULATION=when_required \
    -e AWS_RESPONSE_CHECKSUM_VALIDATION=when_required \
    -v "$PWD:/work" \
    -w /work \
    "$AWS_CLI_IMAGE" \
    --endpoint-url "http://$HOST:${PORT:-9000}" \
    "$@"
