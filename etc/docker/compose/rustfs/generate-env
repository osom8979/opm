#!/usr/bin/env bash

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$ROOT_DIR/.env"
TEMPLATE_FILE="$ROOT_DIR/env-template"

red()    { printf "\033[1;31m%s\033[0m\n" "$*"; }
green()  { printf "\033[1;32m%s\033[0m\n" "$*"; }
yellow() { printf "\033[1;33m%s\033[0m\n" "$*"; }

if [ -f "$ENV_FILE" ]; then
    red ".env already exists: $ENV_FILE"
    red "Remove it first if you want to regenerate."
    exit 1
fi

if [ ! -f "$TEMPLATE_FILE" ]; then
    red "Template not found: $TEMPLATE_FILE"
    exit 1
fi

USER_UID="$(id -u)"
USER_GID="$(id -g)"

# The access key is a public identifier, the secret key is not. Both must be
# non-default: rustfs falls back to `rustfsadmin`/`rustfsadmin` when unset and
# only warns about it.
RUSTFS_ACCESS_KEY="$(openssl rand -hex 10)"
RUSTFS_SECRET_KEY="$(openssl rand -hex 32)"

sed \
    -e "s/@USER_UID@/$USER_UID/g" \
    -e "s/@USER_GID@/$USER_GID/g" \
    -e "s/@RUSTFS_ACCESS_KEY@/$RUSTFS_ACCESS_KEY/g" \
    -e "s/@RUSTFS_SECRET_KEY@/$RUSTFS_SECRET_KEY/g" \
    "$TEMPLATE_FILE" > "$ENV_FILE"

if [[ $? -ne 0 ]]; then
    red "Failed to generate .env"
    exit 1
fi

green "Generated: $ENV_FILE"
echo
yellow "Set the directory to serve before starting -- it defaults to ./data:"
yellow "  RUSTFS_DATA_DIR"
echo
yellow "Generated credentials -- they are not stored anywhere else:"
yellow "  RUSTFS_ACCESS_KEY=$RUSTFS_ACCESS_KEY"
yellow "  RUSTFS_SECRET_KEY=$RUSTFS_SECRET_KEY"
