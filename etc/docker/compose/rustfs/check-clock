#!/usr/bin/env bash
#
# Clock skew check for the host that serves this stack.
#
# SigV4 refuses a request whose signing time sits more than 15 minutes from the
# server's clock -- S3 answers `403 RequestTimeTooSkewed`. Most clients report
# that as an authentication failure, so a drifting host clock looks exactly
# like a wrong secret key while every credential in the .env is correct.
#
#   ./check-clock              # report only, changes nothing
#   ./check-clock --fix        # NTP first, setting the clock as a fallback
#   ./check-clock --fix -y     # same, without the confirmation prompt
#
# The reference clock is read over HTTPS, not NTP: a host that is unsynchronised
# usually got that way because UDP 123 is blocked, and this has to work there.

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$ROOT_DIR/.env"
ORIG_ARGS=("$@")

# The SigV4 window. Past this, every signed request is refused.
SIGV4_SKEW_LIMIT=900
# Below this it is jitter, not drift.
OK_SKEW=2
CURL_TIMEOUT=8
# How long to wait for a daemon to report a synchronised clock.
SYNC_WAIT=45

FIX=0
ASSUME_YES=0
ENDPOINT=""

red()    { printf "\033[1;31m%s\033[0m\n" "$*"; }
green()  { printf "\033[1;32m%s\033[0m\n" "$*"; }
yellow() { printf "\033[1;33m%s\033[0m\n" "$*"; }
head1()  { printf "\n\033[1m%s\033[0m\n" "$*"; }

usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --fix            Correct the clock: NTP first, manual set as fallback"
    echo "  -y, --yes        Skip confirmation prompts"
    echo "  --endpoint URL   RustFS endpoint to cross-check (default: from .env)"
    echo "  --help           Show this help message"
    echo ""
    echo "Exit codes:"
    echo "  0  clock is within ${OK_SKEW}s of the reference"
    echo "  1  clock is off (S3 will reject signed requests past ${SIGV4_SKEW_LIMIT}s)"
    echo "  2  usage or environment error"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --fix) FIX=1; shift ;;
        -y|--yes) ASSUME_YES=1; shift ;;
        --endpoint) ENDPOINT="$2"; shift 2 ;;
        --endpoint=*) ENDPOINT="${1#--endpoint=}"; shift ;;
        --help) usage; exit 0 ;;
        *) echo "Unknown option: $1" 1>&2; usage 1>&2; exit 2 ;;
    esac
done

if ! command -v curl > /dev/null 2>&1; then
    red "curl is required."
    exit 2
fi

if [ "$FIX" -eq 1 ] && [ "$(id -u)" -ne 0 ]; then
    if command -v sudo > /dev/null 2>&1; then
        yellow "--fix changes the system clock; re-running under sudo ..."
        exec sudo -- "$0" "${ORIG_ARGS[@]}"
    fi
    red "--fix must run as root."
    exit 2
fi

# date +%s.%N is GNU; fall back to whole seconds if it is not honoured.
now_float() {
    local t
    t=$(date +%s.%N 2>/dev/null)
    case "$t" in
        *N*|"") date +%s ;;
        *) printf '%s' "$t" ;;
    esac
}

abs_of() {
    awk -v o="$1" 'BEGIN { printf "%.3f", (o < 0 ? -o : o) }'
}

# Prints "<offset> <rtt> <source>" -- offset is local minus true time, seconds.
# Both readings bracket the request, so the midpoint cancels most of the RTT.
measure_offset() {
    local t0 t1 body ts hdr server

    t0=$(now_float)
    body=$(curl -fsS -m "$CURL_TIMEOUT" https://cloudflare.com/cdn-cgi/trace 2>/dev/null)
    t1=$(now_float)
    ts=$(printf '%s\n' "$body" | sed -n 's/^ts=//p' | head -1)
    if [ -n "$ts" ]; then
        awk -v a="$t0" -v b="$t1" -v s="$ts" \
            'BEGIN { printf "%.3f %.3f cloudflare\n", (a + b) / 2 - s, b - a }'
        return 0
    fi

    # A Date header is only second-accurate, which is ample against a
    # fifteen-minute window.
    t0=$(now_float)
    hdr=$(curl -fsS -m "$CURL_TIMEOUT" -D - -o /dev/null https://www.google.com 2>/dev/null \
        | grep -i '^date:' | head -1 | sed 's/^[^:]*: *//' | tr -d '\r')
    t1=$(now_float)
    if [ -n "$hdr" ]; then
        server=$(date -d "$hdr" +%s 2>/dev/null)
        if [ -n "$server" ]; then
            awk -v a="$t0" -v b="$t1" -v s="$server" \
                'BEGIN { printf "%.3f %.3f http-date\n", (a + b) / 2 - s, b - a }'
            return 0
        fi
    fi

    return 1
}

# 0 = fine, 1 = drifting but still signable, 2 = past the SigV4 window.
verdict_of() {
    local abs
    abs=$(abs_of "$1")
    awk -v a="$abs" -v ok="$OK_SKEW" -v lim="$SIGV4_SKEW_LIMIT" \
        'BEGIN { print (a <= ok ? 0 : (a < lim ? 1 : 2)) }'
}

report_offset() {
    local off rtt src abs verdict sign
    off="$1"; rtt="$2"; src="$3"
    abs=$(abs_of "$off")
    verdict=$(verdict_of "$off")
    sign=$(awk -v o="$off" 'BEGIN { print (o < 0 ? "behind" : "ahead of") }')

    echo "  reference   : $src (round trip ${rtt}s)"
    printf "  offset      : %ss (%s minutes %s true time)\n" \
        "$off" "$(awk -v a="$abs" 'BEGIN { printf "%.1f", a / 60 }')" "$sign"

    case "$verdict" in
        0) green "  verdict     : OK -- within ${OK_SKEW}s" ;;
        1) yellow "  verdict     : drifting -- signs fine today, will not stay that way" ;;
        2) red "  verdict     : BROKEN -- past the ${SIGV4_SKEW_LIMIT}s SigV4 window; S3 answers 403 RequestTimeTooSkewed" ;;
    esac

    return "$verdict"
}

ntp_daemon() {
    if command -v chronyc > /dev/null 2>&1; then
        if systemctl is-active --quiet chrony 2>/dev/null \
            || systemctl is-active --quiet chronyd 2>/dev/null; then
            echo chrony; return
        fi
    fi
    if systemctl is-active --quiet systemd-timesyncd 2>/dev/null; then
        echo timesyncd; return
    fi
    if systemctl is-active --quiet ntp 2>/dev/null \
        || systemctl is-active --quiet ntpsec 2>/dev/null; then
        echo ntpd; return
    fi
    echo none
}

synced() {
    [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = "yes" ]
}

wait_for_sync() {
    local i
    for i in $(seq 1 "$1"); do
        synced && return 0
        sleep 1
    done
    return 1
}

confirm() {
    [ "$ASSUME_YES" -eq 1 ] && return 0
    printf "%s [y/N] " "$1"
    read -r reply
    case "$reply" in
        [yY]|[yY][eE][sS]) return 0 ;;
        *) return 1 ;;
    esac
}

# --- 1. what the host thinks ------------------------------------------------

head1 "Host clock"
echo "  local       : $(date '+%F %T %Z')"
echo "  utc         : $(date -u '+%F %T UTC')"

if command -v timedatectl > /dev/null 2>&1; then
    echo "  ntp service : $(timedatectl show -p NTP --value 2>/dev/null)"
    echo "  synchronised: $(timedatectl show -p NTPSynchronized --value 2>/dev/null)"
    echo "  daemon      : $(ntp_daemon)"
fi

# The RTC is what a reboot restores, so a corrected system clock that never
# reached the RTC comes back wrong.
if [ "$(id -u)" -eq 0 ] && command -v hwclock > /dev/null 2>&1; then
    echo "  rtc         : $(hwclock --show 2>/dev/null || echo 'unreadable')"
fi

if grep -qi microsoft /proc/version 2>/dev/null; then
    yellow "  note        : WSL -- its clock lags after the Windows host sleeps"
elif command -v systemd-detect-virt > /dev/null 2>&1; then
    virt=$(systemd-detect-virt 2>/dev/null)
    if [ -n "$virt" ] && [ "$virt" != "none" ]; then
        echo "  virtualised : $virt (guest clocks lag after the host suspends)"
    fi
fi

# --- 2. what the world thinks -----------------------------------------------

head1 "Offset against a reference clock"
if ! reading=$(measure_offset); then
    red "  Could not reach a reference clock (no HTTPS egress?)."
    red "  Compare by hand against a phone or another synchronised machine."
    exit 2
fi
offset=$(echo "$reading" | awk '{ print $1 }')
rtt=$(echo "$reading" | awk '{ print $2 }')
source=$(echo "$reading" | awk '{ print $3 }')
report_offset "$offset" "$rtt" "$source"
verdict=$?

# --- 3. fix -----------------------------------------------------------------

if [ "$FIX" -eq 1 ] && [ "$verdict" -ne 0 ]; then
    head1 "Correcting"

    case "$(ntp_daemon)" in
        chrony)
            yellow "  chrony: stepping the clock ..."
            chronyc makestep > /dev/null 2>&1
            chronyc waitsync 10 0.5 > /dev/null 2>&1
            ;;
        ntpd)
            yellow "  restarting the NTP daemon ..."
            systemctl restart ntp > /dev/null 2>&1 || systemctl restart ntpsec > /dev/null 2>&1
            wait_for_sync "$SYNC_WAIT"
            ;;
        *)
            yellow "  enabling NTP and restarting systemd-timesyncd ..."
            timedatectl set-ntp true > /dev/null 2>&1
            systemctl restart systemd-timesyncd > /dev/null 2>&1
            wait_for_sync "$SYNC_WAIT"
            ;;
    esac

    reading=$(measure_offset) && {
        offset=$(echo "$reading" | awk '{ print $1 }')
        verdict=$(verdict_of "$offset")
    }

    # NTP silently does nothing when UDP 123 is blocked, which is the common
    # case on a host that drifted this far. Set the clock from HTTPS instead.
    if [ "$verdict" -ne 0 ]; then
        yellow "  NTP did not correct it -- UDP 123 is most likely blocked."
        if confirm "  Set the clock directly from the HTTPS reference?"; then
            reading=$(measure_offset)
            if [ -z "$reading" ]; then
                red "  Lost the reference clock; aborting."
                exit 1
            fi
            off=$(echo "$reading" | awk '{ print $1 }')
            target=$(awk -v l="$(now_float)" -v o="$off" 'BEGIN { printf "%.0f", l - o }')

            timedatectl set-ntp false > /dev/null 2>&1
            if date -u -s "@$target" > /dev/null 2>&1; then
                green "  Clock set to $(date '+%F %T %Z')."
            else
                red "  Failed to set the clock."
                exit 1
            fi

            if command -v hwclock > /dev/null 2>&1; then
                if hwclock --systohc 2>/dev/null; then
                    green "  RTC written (survives a reboot)."
                else
                    yellow "  Could not write the RTC -- no battery-backed clock here."
                fi
            fi

            # Leave NTP on: harmless while blocked, and it takes over the moment
            # the port opens.
            timedatectl set-ntp true > /dev/null 2>&1

            reading=$(measure_offset) && {
                offset=$(echo "$reading" | awk '{ print $1 }')
                verdict=$(verdict_of "$offset")
            }
        else
            yellow "  Skipped."
        fi
    fi

    head1 "After"
    if [ -n "$reading" ]; then
        rtt=$(echo "$reading" | awk '{ print $2 }')
        source=$(echo "$reading" | awk '{ print $3 }')
        report_offset "$offset" "$rtt" "$source"
        verdict=$?
    else
        red "  Lost the reference clock; re-run to confirm."
        verdict=1
    fi
fi

# --- 4. cross-check what RustFS reports -------------------------------------

if [ -z "$ENDPOINT" ] && [ -f "$ENV_FILE" ]; then
    port=$(sed -n 's/^RUSTFS_S3_PORT=//p' "$ENV_FILE" | head -1 | tr -d '[:space:]')
    [ -n "$port" ] && ENDPOINT="http://127.0.0.1:$port"
fi

if [ -n "$ENDPOINT" ]; then
    head1 "RustFS endpoint"
    echo "  endpoint    : $ENDPOINT"
    served=$(curl -fsS -m "$CURL_TIMEOUT" -D - -o /dev/null "${ENDPOINT%/}/health" 2>/dev/null \
        | grep -i '^date:' | head -1 | sed 's/^[^:]*: *//' | tr -d '\r')
    if [ -n "$served" ]; then
        echo "  its Date hdr: $served"
        yellow "  (behind a proxy or tunnel this header is the PROXY's clock, not the origin's)"
    else
        yellow "  No answer -- not running, or reachable only from elsewhere."
    fi

    # Containers read the host's clock, so this must agree with the host. If it
    # does not, the container runtime is running its own VM (Docker Desktop).
    if command -v docker > /dev/null 2>&1 && docker ps > /dev/null 2>&1; then
        name=$(docker ps --format '{{.Names}}' | grep -i rustfs | head -1)
        if [ -n "$name" ]; then
            echo "  container   : $name -> $(docker exec "$name" date -u '+%F %T UTC' 2>/dev/null || echo 'no date(1) in image')"
        fi
    fi
fi

head1 "Result"
case "$verdict" in
    0)
        green "  Clock is good. RequestTimeTooSkewed is not your problem."
        exit 0
        ;;
    1)
        yellow "  Clock is drifting. Keep NTP working before it crosses ${SIGV4_SKEW_LIMIT}s."
        [ "$FIX" -eq 0 ] && yellow "  Re-run with --fix to correct it."
        exit 1
        ;;
    *)
        red "  Clock is past the SigV4 window -- every S3 client will get 403."
        [ "$FIX" -eq 0 ] && red "  Re-run with --fix to correct it."
        exit 1
        ;;
esac
